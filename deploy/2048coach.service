# systemd unit for the 2048 Coach app server (Node) and its engine processes. Installed by deploy/setup.sh.
[Unit]
Description=2048 Coach (app server + engine)
After=network-online.target
Wants=network-online.target

[Service]
User=coach
Group=coach
WorkingDirectory=/opt/2048-coach/app
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8048
# behind Caddy: the client IP comes from X-Forwarded-For (Caddy sets it; it does not pass on a client's own)
Environment=TRUST_PROXY=1
Environment=LOG_REQUESTS=1
Environment=CORS_ORIGINS=https://2048coach.com
ExecStart=/usr/bin/node server/src/index.ts
Restart=always
RestartSec=3
# the engine raises its stack limit (ulimit -s unlimited)
LimitSTACK=infinity
TimeoutStopSec=20

# hardening: the app only reads its files and writes review files to its private /tmp
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=3G

[Install]
WantedBy=multi-user.target
