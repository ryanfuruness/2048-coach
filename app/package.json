{
  "name": "2048-coach-app",
  "private": true,
  "version": "0.1.0",
  "description": "Local web app for the 2048 analysis engine: play with a coach, review games, analyze positions.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config web/vite.config.ts && node scripts/compress.mjs",
    "server": "node server/src/index.ts",
    "typecheck": "tsc -p web/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run --config web/vitest.config.ts && node --test \"server/test/*.test.ts\"",
    "test:engine": "ENGINE_TESTS=1 vitest run --config web/vitest.config.ts && ENGINE_TESTS=1 node --test \"server/test/*.test.ts\"",
    "qa": "node qa/run-journeys.mjs",
    "lighthouse": "node qa/run-lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.1",
    "lighthouse": "^13.5.0",
    "playwright": "1.63",
    "typescript": "5.9",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
